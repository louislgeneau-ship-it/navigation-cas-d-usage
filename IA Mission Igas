const $=id=>document.getElementById(id);
let type="g",dom=0,query="";
const norm=s=>s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");
const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!==undefined)e.textContent=x;return e};
const count=t=>D[t].reduce((n,d)=>n+(d[1]?d[1].length:0),0);
function list(txt){if(!txt){return el("span","nd","N.D.")}const u=el("ul");txt.split(" ; ").forEach(s=>u.append(el("li","",s)));return u}
function card(e,domName){const a=el("article");if(domName)a.append(el("p","dom",domName));a.append(el("h3","",e[0]));const dl=el("dl");
 const row=(k,v)=>{dl.append(el("dt","",k));const d=el("dd");d.append(v);dl.append(d)};
 row("Exemples d’administrations publiques utilisatrices",list(e[1]));
 row("Principale catégorie de gain déclaré",e[2]?el("span","cat",CATS[e[2]]):el("span","nd","N.D."));
 row("Exemples de gains déclarés",list(e[3]));a.append(dl);return a}
function render(){
 const tabs=$("tabs");tabs.textContent="";
 Object.keys(TYPES).forEach(k=>{const b=el("button","tab",TYPES[k]);b.setAttribute("role","tab");b.setAttribute("aria-selected",k===type&&!query);b.append(el("span","","("+count(k)+")"));b.onclick=()=>{type=k;dom=D[k].findIndex(d=>d[1]);query="";$("q").value="";render()};tabs.append(b)});
 const nav=$("nav"),main=$("main");nav.textContent="";main.textContent="";
 if(query){nav.hidden=true;const q=norm(query);let n=0;
  Object.keys(D).forEach(k=>D[k].forEach(d=>{if(!d[1])return;d[1].forEach(e=>{if(norm(e.join(" ")).includes(q)){n++;main.append(card(e,TYPES[k]+" – "+d[0]))}})}));
  main.prepend(el("p","cnt",n+" résultat"+(n>1?"s":"")+" pour « "+query+" »"));if(!n)main.append(el("p","nd","Aucun cas d’usage ne correspond."));return}
 nav.hidden=false;
 D[type].forEach((d,i)=>{if(!d[1]){nav.append(el("h2","",d[0].slice(1)));return}
  const b=el("button","",d[0]);b.append(" ");b.append(el("small","","("+d[1].length+")"));if(i===dom)b.setAttribute("aria-current","true");b.onclick=()=>{dom=i;render();scrollTo(0,0)};nav.append(b)});
 const d=D[type][dom];main.append(el("h2","",d[0]));main.append(el("p","cnt",d[1].length+" cas d’usage"));d[1].forEach(e=>main.append(card(e)))}
